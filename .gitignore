.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE and Editor Files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage/

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node_modules (if using any build tools)
node_modules/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# Development and testing files
*.test.js
test/
tests/

# Temporary files
*.tmp
*.temp
.tmp/

# Chrome Extension specific
*.crx
*.pem
key.pem

# Build directories (if using build process)
dist/
build/

# API Keys and sensitive data (if any config files are added later)
config/secrets.js
secrets.json
.env.local
.env.development.local
.env.test.local
.env.production.local

# Backup files
*.bak
*.backup
*-backup.*
*-old.*
manifest-backup.*

# Claude AI working directory (optional, keep for development reference)
# .claude/

# Local development files
local-config.js
dev-settings.json

# OS generated files
.fseventsd
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
desktop.ini

